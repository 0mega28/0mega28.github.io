---
import BaseLayout from "./BaseLayout.astro";
import TableOfContents from "../components/TableOfContents.astro";
import PostMeta from "../components/PostMeta.astro";
import SeriesNav from "../components/SeriesNav.astro";
import { getReadingTime } from "../utils/readingTime";
import { SITE_AUTHOR, SITE_URL } from "../consts";
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";

interface Props {
    post: CollectionEntry<"blog">;
    headings: MarkdownHeading[];
    seriesTitle?: string;
    prev: { id: string; title: string } | null;
    next: { id: string; title: string } | null;
}

const { post, headings, seriesTitle, prev, next } = Astro.props;
const hasToc = headings.some((h) => h.depth === 2 || h.depth === 3);
const readingTime = getReadingTime(post.body || "");

const siteUrl = (Astro.site || SITE_URL).toString().replace(/\/$/, "");
const postUrl = `${siteUrl}/blog/${post.id}/`;
const ogImageUrl = new URL(post.data.ogImage || "/og-image.jpg", siteUrl).href;

const articleSchema = JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.publishDate.toISOString(),
    ...(post.data.updatedDate && {
        dateModified: post.data.updatedDate.toISOString(),
    }),
    image: ogImageUrl,
    author: {
        "@type": "Person",
        name: SITE_AUTHOR,
        url: siteUrl,
    },
    url: postUrl,
});

const breadcrumbItems = [
    {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: `${siteUrl}/`,
    },
    {
        "@type": "ListItem",
        position: 2,
        name: "Blog",
        item: `${siteUrl}/blog/`,
    },
];

if (post.data.series && seriesTitle) {
    breadcrumbItems.push({
        "@type": "ListItem",
        position: 3,
        name: seriesTitle,
        item: `${siteUrl}/blog/${post.data.series}/`,
    });
}

breadcrumbItems.push({
    "@type": "ListItem",
    position: breadcrumbItems.length + 1,
    name: post.data.title,
    item: postUrl,
});

const breadcrumbSchema = JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbItems,
});
---

<BaseLayout title={post.data.title} description={post.data.description} ogType="article">
    <script is:inline type="application/ld+json" set:html={articleSchema} />
    <script is:inline type="application/ld+json" set:html={breadcrumbSchema} />
    <div class={`post-layout ${hasToc ? "" : "no-toc"}`}>
        <header class="post-header">
            <a href="/blog" class="back-link"> ← All Posts </a>
            {
                post.data.series && (
                    <div class="post-series-meta">
                        Part of the{" "}
                        <a href={`/blog/${post.data.series}`}>{seriesTitle || post.data.series}</a>{" "}
                        series
                    </div>
                )
            }
            <h1>{post.data.title}</h1>
            <PostMeta
                publishDate={post.data.publishDate}
                readingTime={readingTime}
                draft={post.data.draft}
            />
            {
                post.data.tags && post.data.tags.length > 0 && (
                    <div class="post-tags">
                        {post.data.tags.map((tag) => (
                            <span class="tag-pill">#{tag}</span>
                        ))}
                    </div>
                )
            }
        </header>

        {
            hasToc && (
                <aside class="post-sidebar">
                    <TableOfContents headings={headings} />
                </aside>
            )
        }

        <article class="post-content">
            <slot />

            {post.data.series && <SeriesNav prev={prev} next={next} />}
        </article>
    </div>
</BaseLayout>

<style>
    .back-link {
        display: inline-block;
        font-size: 0.85rem;
        font-family: var(--font-mono);
        text-decoration: none;
        color: var(--color-muted);
        margin-bottom: 1.5rem;
        transition: color 0.15s;
    }

    .back-link:hover {
        color: var(--color-accent);
    }

    .post-series-meta {
        font-size: 0.85rem;
        font-family: var(--font-mono);
        color: var(--color-muted);
        margin-bottom: 0.5rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .post-series-meta a {
        color: var(--color-accent);
        text-decoration: none;
        font-weight: 500;
    }

    .post-series-meta a:hover {
        text-decoration: underline;
    }

    .post-layout {
        display: grid;
        grid-template-areas:
            "header"
            "toc"
            "content";
        grid-template-columns: 100%;
        gap: 1.5rem;
    }

    .post-layout.no-toc {
        grid-template-areas:
            "header"
            "content";
        max-width: var(--max-width);
        margin: 0 auto;
    }

    .post-header {
        grid-area: header;
        margin-bottom: 1rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid var(--color-border);
    }

    .post-header h1 {
        font-size: 2.25rem;
        margin-top: 0;
        margin-bottom: 0.5rem;
    }

    .post-sidebar {
        grid-area: toc;
    }

    .post-content {
        grid-area: content;
        line-height: 1.8;
    }

    /* Make sure spacing is nice inside markdown posts */
    .post-content :global(p) {
        margin-bottom: 1.5rem;
    }

    /* List spacing and nested list alignment */
    .post-content :global(ul),
    .post-content :global(ol) {
        margin-top: 0.5rem;
        margin-bottom: 1.5rem;
        padding-left: 1.75rem;
    }

    .post-content :global(li) {
        margin-bottom: 0.4rem;
        line-height: 1.75;
    }

    .post-content :global(li > ul),
    .post-content :global(li > ol) {
        margin-top: 0.35rem;
        margin-bottom: 0.35rem;
        padding-left: 1.5rem;
    }

    .post-content :global(ul ul) {
        list-style-type: circle;
    }

    .post-content :global(ul ul ul) {
        list-style-type: square;
    }

    .post-content :global(ol ol) {
        list-style-type: lower-alpha;
    }

    /* Table styling */
    .post-content :global(table) {
        width: 100%;
        border-collapse: collapse;
        margin: 1.5rem 0;
        font-size: 0.95rem;
        line-height: 1.6;
    }

    .post-content :global(th),
    .post-content :global(td) {
        padding: 0.65rem 1rem;
        border: 1px solid var(--color-border);
        text-align: left;
        vertical-align: middle;
    }

    .post-content :global(th) {
        font-family: var(--font-heading);
        font-weight: 600;
        background-color: var(--color-surface);
        color: var(--color-text);
    }

    .post-content :global(tbody tr:nth-child(even)) {
        background-color: rgba(0, 0, 0, 0.02);
    }

    :root[data-theme="dark"] .post-content :global(tbody tr:nth-child(even)) {
        background-color: rgba(255, 255, 255, 0.03);
    }

    .post-content :global(details table) {
        margin: 1rem 0;
        font-size: 0.9rem;
    }

    .post-content :global(details th) {
        background-color: var(--color-bg);
    }

    .post-content :global(details tbody tr:nth-child(even)) {
        background-color: var(--color-bg);
    }

    .post-content :global(h2),
    .post-content :global(h3) {
        margin-top: 2.5rem;
        margin-bottom: 1rem;
    }

    @media (min-width: 900px) {
        .post-layout:not(.no-toc) {
            grid-template-columns: 1fr 280px;
            grid-template-areas:
                "header header"
                "content toc";
            gap: 3.5rem;
        }

        .post-sidebar {
            position: sticky;
            top: 2rem;
            height: fit-content;
        }
    }

    .post-tags {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin-top: 0.75rem;
    }

    .tag-pill {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--color-accent);
        background-color: var(--color-bg);
        border: 1px solid var(--color-border);
        padding: 0.15rem 0.5rem;
        border-radius: 4px;
        transition: all 0.15s ease;
    }

    .tag-pill:hover {
        background-color: var(--color-accent);
        color: var(--color-bg);
        border-color: var(--color-accent);
    }

    .post-content :global(details) {
        border-left: 3px solid var(--color-accent);
        background: var(--color-surface);
        border-radius: 0 6px 6px 0;
        padding: 1rem 1.25rem;
        margin: 1.5rem 0;
        overflow-x: auto;
    }

    .post-content :global(details summary) {
        font-family: var(--font-heading);
        font-weight: 600;
        font-size: 0.95rem;
        cursor: pointer;
        color: var(--color-accent);
        list-style: none;
        display: flex;
        align-items: center;
        gap: 0.4rem;
        user-select: none;
    }

    .post-content :global(details summary::before) {
        content: "▸";
        transition: transform 0.2s ease;
        display: inline-block;
    }

    .post-content :global(details[open] summary::before) {
        transform: rotate(90deg);
    }

    .post-content :global(details summary::-webkit-details-marker) {
        display: none;
    }

    .post-content :global(details[open] summary) {
        margin-bottom: 0.75rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid var(--color-border);
    }

    .post-content :global(details p),
    .post-content :global(details li) {
        font-size: 0.95rem;
        line-height: 1.7;
    }

    .post-content :global(details p:last-child) {
        margin-bottom: 0;
    }
</style>
