---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostMeta from "../../components/PostMeta.astro";
import { draftFilter, bySeriesOrder } from "../../utils/collections";
import { getReadingTime } from "../../utils/readingTime";

const posts = await getCollection("blog", draftFilter);

const seriesList = await getCollection("series");
const seriesMetadataMap = new Map(seriesList.map((s) => [s.id, s.data]));

const seriesPosts = posts.filter((p) => p.data.series);
const standalonePosts = posts.filter((p) => !p.data.series);

// Sort standalone posts by publishDate descending (Task 3.4)
standalonePosts.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const seriesMap = seriesPosts.reduce(
    (acc, post) => {
        const seriesId = post.data.series!;
        const meta = seriesMetadataMap.get(seriesId);
        const seriesTitle = meta ? meta.title : seriesId;
        if (!acc[seriesId]) acc[seriesId] = { title: seriesTitle, posts: [] };
        acc[seriesId].posts.push(post);
        return acc;
    },
    {} as Record<string, { title: string; posts: typeof seriesPosts }>,
);

Object.values(seriesMap).forEach((s) =>
    s.posts.sort(bySeriesOrder),
);
---

<BaseLayout title="Blog">
    <h1>Blog</h1>

    <br />
    {
        Object.entries(seriesMap).map(([series, { title, posts }]) => (
            <section class="series-section">
                <h2 class="series-title">
                    <a href={`/blog/${series}`}>{title}</a>
                </h2>
                <ol class="post-list">
                    {posts.map((post) => (
                        <li class="post-item">
                            <a href={`/blog/${post.id}`}>{post.data.title}</a>
                            <PostMeta
                                publishDate={post.data.publishDate}
                                readingTime={getReadingTime(post.body || "")}
                                draft={post.data.draft}
                                class="post-meta-row"
                            />
                        </li>
                    ))}
                </ol>
            </section>
        ))
    }

    {
        standalonePosts.length > 0 && (
            <section class="series-section">
                <h2 class="series-title">Posts</h2>
                <ol class="post-list">
                    {standalonePosts.map((post) => (
                        <li class="post-item">
                            <a href={`/blog/${post.id}`}>{post.data.title}</a>
                            <PostMeta
                                publishDate={post.data.publishDate}
                                readingTime={getReadingTime(post.body || "")}
                                draft={post.data.draft}
                                class="post-meta-row"
                            />
                        </li>
                    ))}
                </ol>
            </section>
        )
    }
</BaseLayout>

<style>
    .series-section {
        margin-bottom: 2.5rem;
    }

    .series-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--color-muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.75rem;
        margin-top: 0;
    }

    .series-title a {
        text-decoration: none;
        color: inherit;
    }

    .series-title a:hover {
        color: var(--color-accent);
    }

    .post-list {
        list-style: none;
        padding: 0;
        padding-left: 1.5rem;
        margin: 0;
    }

    .post-item {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        padding: 0.6rem 0;
        border-bottom: 1px solid var(--color-border);
    }

    .post-item a {
        text-decoration: none;
        color: var(--color-text);
        font-size: 1rem;
    }

    .post-item a:hover {
        color: var(--color-accent);
    }

    .post-meta-row {
        margin-left: 1rem;
        flex-shrink: 0;
    }

    @media (max-width: 600px) {
        .post-item {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.35rem;
            padding: 0.8rem 0;
        }

        .post-meta-row {
            margin-left: 0;
        }
    }
</style>
