---
import { getCollection, render } from "astro:content";
import { draftFilter, bySeriesOrder } from "../../utils/collections";
import PostLayout from "../../layouts/PostLayout.astro";
import SeriesLayout from "../../layouts/SeriesLayout.astro";

export async function getStaticPaths() {
    const posts = await getCollection("blog", draftFilter);
    const seriesList = await getCollection("series");

    const seriesMetadataMap = new Map(seriesList.map((s) => [s.id, s.data]));

    // Pre-build Map<seriesId, sortedPosts[]> once instead of O(N^2) refiltering (Task 2.4)
    const postsBySeries = new Map<string, typeof posts>();
    posts.forEach((post) => {
        if (post.data.series) {
            if (!postsBySeries.has(post.data.series)) {
                postsBySeries.set(post.data.series, []);
            }
            postsBySeries.get(post.data.series)!.push(post);
        }
    });
    postsBySeries.forEach((seriesPosts) => {
        seriesPosts.sort(bySeriesOrder);
    });

    const postPaths = posts.map((post) => {
        let prev = null;
        let next = null;
        let seriesTitle = "";

        if (post.data.series) {
            const seriesPosts = postsBySeries.get(post.data.series) || [];
            const index = seriesPosts.findIndex((p) => p.id === post.id);
            if (index > 0) {
                prev = {
                    id: seriesPosts[index - 1].id,
                    title: seriesPosts[index - 1].data.title,
                };
            }
            if (index < seriesPosts.length - 1) {
                next = {
                    id: seriesPosts[index + 1].id,
                    title: seriesPosts[index + 1].data.title,
                };
            }

            // Fix series title display (Task 3.1)
            const seriesMeta = seriesMetadataMap.get(post.data.series);
            seriesTitle = seriesMeta ? seriesMeta.title : post.data.series;
        }

        return {
            params: { slug: post.id },
            props: { type: "post" as const, post, prev, next, seriesTitle },
        };
    });

    const seriesPaths = seriesList.map((series) => {
        const seriesPosts = postsBySeries.get(series.id) || [];

        return {
            params: { slug: series.id },
            props: { type: "series" as const, series, posts: seriesPosts },
        };
    });

    return [...postPaths, ...seriesPaths];
}

const props = Astro.props;
---

{
    props.type === "post"
        ? (() => {
              const { post, prev, next, seriesTitle } = props;
              return render(post).then(({ Content, headings }) => {
                  return (
                      <PostLayout
                          post={post}
                          headings={headings}
                          seriesTitle={seriesTitle}
                          prev={prev}
                          next={next}
                      >
                          <Content />
                      </PostLayout>
                  );
              });
          })()
        : (() => {
              const { series, posts } = props;
              return (
                  <SeriesLayout series={series} posts={posts} />
              );
          })()
}
