---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getReadingTime } from '../../utils/readingTime';
import TableOfContents from '../../components/TableOfContents.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', p =>
    import.meta.env.DEV ? true : !p.data.draft
  );

  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}
const hasToc = headings.some(h => h.depth === 2 || h.depth === 3);
---

<BaseLayout title={post.data.title} description={post.data.description} wide={hasToc}>
  <div class={`post-layout ${hasToc ? '' : 'no-toc'}`}>
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <div class="post-meta-container">
        <time datetime={post.data.publishDate.toISOString()} class="post-date">
          {formatDate(post.data.publishDate)}
        </time>
        <span class="post-reading-time">· {getReadingTime(post.body || '')} min read</span>
        {post.data.draft && <span class="draft-badge">draft</span>}
      </div>
    </header>
    
    {hasToc && (
      <aside class="post-sidebar">
        <TableOfContents headings={headings} />
      </aside>
    )}
    
    <article class="post-content">
      <Content />
    </article>
  </div>
</BaseLayout>

<style>
  .post-layout {
    display: grid;
    grid-template-areas:
      "header"
      "toc"
      "content";
    grid-template-columns: 100%;
    gap: 1.5rem;
  }

  .post-layout.no-toc {
    grid-template-areas:
      "header"
      "content";
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .post-header {
    grid-area: header;
    margin-bottom: 1rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .post-header h1 {
    font-size: 2.25rem;
    margin-top: 0;
    margin-bottom: 0.5rem;
  }

  .post-meta-container {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9rem;
    color: var(--color-muted);
  }

  .post-sidebar {
    grid-area: toc;
  }

  .post-content {
    grid-area: content;
    line-height: 1.8;
  }

  /* Make sure spacing is nice inside markdown posts */
  .post-content :global(p) {
    margin-bottom: 1.5rem;
  }

  .post-content :global(h2),
  .post-content :global(h3) {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  @media (min-width: 900px) {
    .post-layout:not(.no-toc) {
      grid-template-columns: 1fr 280px;
      grid-template-areas:
        "header header"
        "content toc";
      gap: 3.5rem;
    }

    .post-sidebar {
      position: sticky;
      top: 2rem;
      height: fit-content;
    }
  }
</style>
