---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Home">
    <div class="profile-layout">
        <div class="profile-sidebar">
            <img src="/avatar.jpeg" alt="Saksham Gupta" class="profile-image" />
        </div>
        <article class="profile-content">
            <h1>Saksham Gupta</h1>

            <div class="bio-content">
                <p class="punchline">I like to understand things from the layer underneath.</p>

                <p>
                    When something doesn't make sense, I keep going down until it does: from the
                    code to the runtime, and from the runtime to the machine.
                </p>

                <p>
                    Usually that means rebuilding it. I've written a 32-bit UNIX-like kernel, an
                    out-of-order CPU simulator, and a few parsers, mostly to find out how the real
                    ones work.
                </p>

                <p>
                    Right now I'm doing the same with distributed systems: reading the classic
                    papers, and the ones behind today's large-scale storage and stream-processing
                    systems, and writing up what I find here.
                </p>

                <p class="blog-cta">
                    <a href="/blog">Read the blog →</a>
                </p>
            </div>
        </article>
    </div>
</BaseLayout>

<style>
    .profile-layout {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2.5rem;
        align-items: start;
        margin: 0 auto;
    }

    @media (min-width: 768px) {
        .profile-layout {
            grid-template-columns: 240px 1fr;
            gap: 3rem;
        }
    }

    .profile-sidebar {
        display: flex;
        justify-content: center;
    }

    @media (min-width: 768px) {
        .profile-sidebar {
            justify-content: flex-start;
        }
    }

    .profile-image {
        width: 100%;
        max-width: 240px;
        height: auto;
        aspect-ratio: 1 / 1;
        object-fit: cover;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        transition:
            transform 0.3s ease,
            box-shadow 0.3s ease;
    }

    :global([data-theme="dark"]) .profile-image {
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
    }

    .profile-image:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
    }

    :global([data-theme="dark"]) .profile-image:hover {
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.5);
    }

    .profile-content h1 {
        font-size: 2.5rem;
        margin-top: 0;
        margin-bottom: 0.5rem;
    }

    .bio-content {
        margin-top: 1.25rem;
        font-size: 1.125rem;
        line-height: 1.8;
    }

    .punchline {
        font-family: var(--font-heading);
        font-size: 1.45rem;
        line-height: 1.4;
        letter-spacing: -0.015em;
        font-weight: 500;
        color: var(--color-text);
        margin-bottom: 1.25rem;
        border-left: 3px solid var(--color-accent);
        padding-left: 1.25rem;
    }

    .bio-content p {
        margin-bottom: 1rem;
    }

    .blog-cta {
        margin-top: 1.5rem;
    }

    .blog-cta a {
        font-weight: 600;
        text-decoration: none;
    }

    .blog-cta a:hover {
        text-decoration: underline;
    }

    @media (min-width: 768px) and (max-height: 800px) {
        .profile-layout {
            grid-template-columns: 200px 1fr;
            gap: 2.5rem;
        }

        .profile-image {
            max-width: 200px;
        }

        .profile-content h1 {
            font-size: 2.25rem;
        }

        .bio-content {
            margin-top: 1rem;
            font-size: 1.05rem;
            line-height: 1.7;
        }

        .punchline {
            font-size: 1.35rem;
            margin-bottom: 1rem;
            padding-left: 1rem;
        }

        .bio-content p {
            margin-bottom: 0.85rem;
        }

        .blog-cta {
            margin-top: 1.25rem;
        }
    }
</style>
